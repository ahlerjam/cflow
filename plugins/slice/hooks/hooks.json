{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}\"/scripts/session-context.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "[ \"$SLICE_RUN\" != 1 ] || node \"${CLAUDE_PLUGIN_ROOT}\"/scripts/guard-features.mjs"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "[ \"$SLICE_RUN\" != 1 ] || node \"${CLAUDE_PLUGIN_ROOT}\"/scripts/guard-features.mjs post"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ \"$SLICE_RUN\" != 1 ] || node \"${CLAUDE_PLUGIN_ROOT}\"/scripts/inbox.mjs"
          }
        ]
      }
    ]
  }
}
