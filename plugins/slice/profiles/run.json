  "env": { "CLAUDE_CODE_RETRY_WATCHDOG": "1", "CLAUDE_CODE_RETRY_WATCHDOG_MAX_USAGE_LIMIT_WAIT_MS": "300000", "DISABLE_AUTOUPDATER": "1", "SLICE_RUN": "1" }
}
