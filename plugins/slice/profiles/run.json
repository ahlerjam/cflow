{
  "permissions": {
    "allow": ["mcp__slice__slice", "Workflow(slice:feature)", "Skill(slice:feature)", "Skill(slice:slice)", "Read", "Grep", "Glob", "ToolSearch", "Skill(slice:taste)", "PushNotification", "CronCreate", "Bash(make check)", "Bash(make verify)", "Bash(make test-affected *)", "Bash(make verify-*)"],
    "deny": ["Bash(git push*)", "Bash(git commit*)", "Bash(gh pr *)", "Bash(git config core.hooksPath*)", "Bash(* --no-verify*)", "WebFetch", "WebSearch"],
    "additionalDirectories": []
